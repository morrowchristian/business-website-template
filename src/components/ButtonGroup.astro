---
/**
 * ButtonGroup Component
 *
 * Purpose:
 * - Layout wrapper for grouping buttons horizontally or vertically.
 */

export const docs = `
## ButtonGroup Component API

### Overview
ButtonGroup arranges multiple Button components in a horizontal or vertical layout, with optional full‑width behavior and customizable spacing. It can also align the group left, center, or right, and render as a segmented (attached) control with shared borders and no gap.

---

### Props

| Prop        | Type                           | Default       | Description |
|-------------|--------------------------------|---------------|-------------|
| \`direction\` | "horizontal" \| "vertical"       | "horizontal"  | Controls layout direction. |
| \`fullWidth\` | boolean                         | false         | Makes the group stretch to full width. |
| \`gap\`       | string                          | "gap-2"       | Tailwind gap utility applied between children. Ignored when \`variant\` is "segmented". |
| \`align\`     | "left" \| "center" \| "right"     | "left"        | Horizontal alignment of the group within its container. |
| \`variant\`   | "default" \| "segmented"          | "default"     | "default" keeps the gap between buttons; "segmented" attaches the buttons with shared borders and no gap. |

---

### Variants

| Variant     | Style |
|-------------|-------|
| \`default\`   | Buttons spaced apart by \`gap\`. |
| \`segmented\` | Buttons attached edge to edge: no gap, shared borders, outer corners rounded and inner corners square. Intended for horizontal groups. |

---

### Slots

| Slot     | Description |
|----------|-------------|
| default  | Buttons or other interactive elements. |

---

### Behavior

- Automatically arranges children in a row or column.
- Supports full‑width mode for responsive layouts.
- Gap is fully customizable using Tailwind utilities (except in segmented mode, where the gap is always 0).
- \`align\` "center" and "right" stretch the group to full width so the alignment is visible.

---

### Usage Example

<ButtonGroup direction="horizontal" gap="gap-4">
  <Button>Save</Button>
  <Button variant="secondary">Cancel</Button>
</ButtonGroup>

<ButtonGroup variant="segmented">
  <Button>Day</Button>
  <Button variant="secondary">Week</Button>
  <Button variant="secondary">Month</Button>
</ButtonGroup>

<ButtonGroup align="center">
  <Button>Save</Button>
  <Button variant="secondary">Cancel</Button>
</ButtonGroup>
`;

interface Props {
  direction?: "horizontal" | "vertical";
  fullWidth?: boolean;
  gap?: string;
  align?: "left" | "center" | "right";
  variant?: "default" | "segmented";
}

const {
  direction = "horizontal",
  fullWidth = false,
  gap = "gap-2",
  align = "left",
  variant = "default",
} = Astro.props;

const isSegmented = variant === "segmented";

const alignClasses = {
  left: "justify-start",
  center: "justify-center",
  right: "justify-end",
};

const layout =
  direction === "vertical"
    ? "flex flex-col"
    : align === "left" && !fullWidth
      ? "inline-flex flex-row"
      : "flex flex-row";

const widthClass = fullWidth || align !== "left" ? "w-full" : "";
const gapClass = isSegmented ? "gap-0" : gap;
const segmentedClass = isSegmented ? "button-group-segmented" : "";
---

<div class={`${layout} ${gapClass} ${widthClass} ${alignClasses[align]} ${segmentedClass}`}>
  <slot />
</div>

<style>
  /* Segmented mode: attach the children edge to edge with shared borders.
     :global is used because the slotted buttons are rendered by the parent. */
  :global(.button-group-segmented) > :first-child {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
  }
  :global(.button-group-segmented) > :not(:first-child) {
    margin-left: -1px;
  }
  :global(.button-group-segmented) > :not(:first-child):not(:last-child) {
    border-radius: 0;
  }
  :global(.button-group-segmented) > :last-child {
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
  }
</style>
