---
/**
 * Header Component
 *
 * Purpose:
 * - Global site header with navigation.
 */

const docs = `
## Header Component API

### Overview
The Header component provides global site navigation, branding, and a mobile menu trigger.  
It loads navigation links from \`src/data/navigation.ts\`.

---

### Props

This component does not accept props.

---

### Behavior

- Displays site title linking to the homepage.
- Renders desktop navigation using your navigation data.
- Includes a mobile menu button (placeholder for future expansion).
- Uses semantic <header> markup.

---

### Usage Example

<Header />
`;


import { navigation } from "../data/navigation";
---

<header class="w-full border-b bg-white">
  <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">

    <a href="/" class="text-xl font-bold tracking-tight">
      Business Website
    </a>

    <nav class="hidden md:flex space-x-6">
      {navigation.map((item) => (
        <a 
          href={item.href} 
          class="text-gray-700 hover:text-blue-600 transition"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <button 
      class="md:hidden p-2 rounded border text-gray-700 hover:bg-gray-100"
      aria-label="Open menu"
    >
      ☰
    </button>

  </div>
</header>
