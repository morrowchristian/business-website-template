---
/**
 * TeamGrid Component
 *
 * Purpose:
 * - Responsive grid of team member bio cards.
 * - Each card shows a photo (with placeholder fallback), name, role, bio, and social links.
 * - Standard team section for business sites.
 * - Three card styles: default (photo top), compact (photo left), circle (round photo, centered text).
 */

export const docs = `
## TeamGrid Component API

### Overview
The TeamGrid component displays a team as a responsive grid of bio cards. Each card shows a photo, name, role, bio, and social links. Missing photos fall back to an initial placeholder.

---

### Props

| Prop        | Type                                | Default   | Description |
|-------------|-------------------------------------|-----------|-------------|
| \`members\`   | Member[]                            | —         | The team members to display. |
| \`columns\`   | number                              | 3         | Columns on desktop (1–4). Mobile is always 1 column, tablet 2. |
| \`cardStyle\` | "default" \| "compact" \| "circle"  | "default" | Card layout. See Card Styles. |

### Member

| Field     | Type                              | Description |
|-----------|-----------------------------------|-------------|
| \`name\`    | string                            | Member's full name. |
| \`role\`    | string                            | Member's role/title. |
| \`bio\`     | string                            | Short bio. Optional. |
| \`photo\`   | string                            | Image URL for the member's photo. Optional — falls back to an initial. |
| \`socials\` | { label: string, href: string }[] | Social/profile links. Optional. |

---

### Card Styles

| Style     | Description |
|-----------|-------------|
| \`default\` | Photo on top (square), name/role/bio/socials below — the classic team card. |
| \`compact\` | Smaller card with the photo on the left and the text on the right. |
| \`circle\`  | Round photo centered above centered text. |

---

### Slots

| Slot    | Description |
|---------|-------------|
| none    | Content is provided entirely through the \`members\` prop. |

---

### Behavior

- Renders members in a responsive grid: 1 column on mobile, 2 on tablet, \`columns\` on desktop.
- Each card: photo (or initial placeholder), name, role, bio, and social links.
- Photos use a square aspect ratio with object-cover; missing photos show the member's initial in a colored circle.
- No framework hydration required.

---

### Usage Examples

<TeamGrid
  members={[
    { name: "Alex Rivera", role: "Founder & CEO", bio: "Started the company in 2018 after a decade in the trade.", socials: [{ label: "LinkedIn", href: "https://linkedin.com" }] },
    { name: "Sam Chen", role: "Lead Installer", bio: "Certified installer with 200+ projects completed." },
  ]}
/>

<TeamGrid columns={4} members={[...]} />

<TeamGrid cardStyle="circle" members={[...]} />
`;

interface Member {
  name: string;
  role: string;
  bio?: string;
  photo?: string;
  socials?: { label: string; href: string }[];
}

interface Props {
  members: Member[];
  columns?: number;
  cardStyle?: "default" | "compact" | "circle";
}

const { members, columns = 3, cardStyle = "default" } = Astro.props;

const gridCols =
  columns <= 1
    ? "sm:grid-cols-1"
    : columns === 2
      ? "sm:grid-cols-2"
      : columns >= 4
        ? "sm:grid-cols-2 lg:grid-cols-4"
        : "sm:grid-cols-2 lg:grid-cols-3";

const articleClass =
  cardStyle === "compact"
    ? "flex gap-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-4 shadow-sm"
    : cardStyle === "circle"
      ? "rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-center shadow-sm"
      : "overflow-hidden rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-sm";

const photoImgClass =
  cardStyle === "compact"
    ? "h-24 w-24 shrink-0 rounded-lg object-cover"
    : cardStyle === "circle"
      ? "mx-auto mt-6 h-32 w-32 rounded-full object-cover"
      : "aspect-square w-full object-cover";

const photoFallbackClass =
  cardStyle === "compact"
    ? "flex h-24 w-24 shrink-0 items-center justify-center rounded-lg bg-blue-50 dark:bg-blue-900/30"
    : cardStyle === "circle"
      ? "mx-auto mt-6 flex h-32 w-32 items-center justify-center rounded-full bg-blue-50 dark:bg-blue-900/30"
      : "flex aspect-square w-full items-center justify-center bg-blue-50 dark:bg-blue-900/30";

const photoFallbackTextClass =
  cardStyle === "compact"
    ? "text-3xl font-bold text-blue-600 dark:text-blue-300"
    : cardStyle === "circle"
      ? "text-4xl font-bold text-blue-600 dark:text-blue-300"
      : "text-6xl font-bold text-blue-600 dark:text-blue-300";

const bodyClass =
  cardStyle === "compact"
    ? "min-w-0 flex-1"
    : cardStyle === "circle"
      ? "p-4 text-center"
      : "p-4";

const socialsClass =
  cardStyle === "circle"
    ? "mt-4 flex flex-wrap justify-center gap-3"
    : "mt-4 flex flex-wrap gap-3";
---

<div class={`grid grid-cols-1 ${gridCols} gap-6`}>
  {members.map((member) => (
    <article class={articleClass}>
      {member.photo ? (
        <img
          src={member.photo}
          alt={`Photo of ${member.name}`}
          class={photoImgClass}
          loading="lazy"
        />
      ) : (
        <div class={photoFallbackClass} aria-hidden="true">
          <span class={photoFallbackTextClass}>
            {member.name.charAt(0)}
          </span>
        </div>
      )}

      <div class={bodyClass}>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">{member.name}</h3>
        <p class="text-sm font-medium text-blue-600">{member.role}</p>

        {member.bio && (
          <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-300">{member.bio}</p>
        )}

        {member.socials && member.socials.length > 0 && (
          <div class={socialsClass}>
            {member.socials.map((s) => (
              <a
                href={s.href}
                class="text-sm font-medium text-blue-600 hover:text-blue-800 hover:underline"
              >
                {s.label}
              </a>
            ))}
          </div>
        )}
      </div>
    </article>
  ))}
</div>
