---
/**
 * Footer Component
 *
 * Purpose:
 * - Global footer with navigation and branding.
 * - Layout variants: default (multi-column), simple (single line), centered (centered content).
 */

export const docs = `
## Footer Component API

### Overview
The Footer component provides site‑wide navigation, branding, and legal information.  
It is fully responsive and uses your global navigation data.

---

### Props

| Prop     | Type                                | Default    | Description |
|----------|-------------------------------------|------------|-------------|
| \`layout\` | "default" \| "simple" \| "centered" | "default" | Controls the footer arrangement. |

---

### Variants

| Variant | Description |
|---------|-------------|
| \`default\` | Multi-column layout: navigation links, an About section, and copyright — the standard site footer. |
| \`simple\` | Single line: copyright on the left, navigation links on the right. |
| \`centered\` | All content centered and stacked: navigation links, About text, and copyright. |

---

### Behavior

- Displays navigation links, an About section, and copyright.
- Fully responsive using a 1–3 column grid (default layout).
- Uses semantic <footer> markup for accessibility.

---

### Usage Example

<Footer />

<Footer layout="simple" />

<Footer layout="centered" />
`;

import { navigation } from "../data/navigation";

interface Props {
  layout?: "default" | "simple" | "centered";
}

const { layout = "default" } = Astro.props;
const year = new Date().getFullYear();
---

{layout === "simple" ? (
  <footer class="w-full border-t bg-gray-50 py-6 mt-12">
    <div class="max-w-6xl mx-auto px-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-gray-600">
        © {year} Business Website. All rights reserved.
      </p>
      <nav>
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          {navigation.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-gray-700 hover:text-blue-600 transition"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </footer>
) : layout === "centered" ? (
  <footer class="w-full border-t bg-gray-50 py-8 mt-12">
    <div class="max-w-6xl mx-auto px-4 flex flex-col items-center text-center gap-6">
      <nav>
        <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2">
          {navigation.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-gray-700 hover:text-blue-600 transition"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <p class="text-gray-600 leading-relaxed max-w-md">
        A clean, modern business website template built with Astro and Tailwind CSS.
      </p>

      <p class="text-gray-600">
        © {year} Business Website. All rights reserved.
      </p>
    </div>
  </footer>
) : (
  <footer class="w-full border-t bg-gray-50 py-8 mt-12">
    <div class="max-w-6xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8">

      <div>
        <h2 class="text-lg font-semibold mb-3">Navigation</h2>
        <ul class="space-y-2">
          {navigation.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-gray-700 hover:text-blue-600 transition"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-lg font-semibold mb-3">About</h2>
        <p class="text-gray-600 leading-relaxed">
          A clean, modern business website template built with Astro and Tailwind CSS.
        </p>
      </div>

      <div class="flex md:justify-end items-start">
        <p class="text-gray-600">
          © {year} Business Website. All rights reserved.
        </p>
      </div>

    </div>
  </footer>
)}
