---
/**
 * Footer Component
 *
 * Purpose:
 * - Global footer with navigation and branding.
 */

const docs = `
## Footer Component API

### Overview
The Footer component provides site‑wide navigation, branding, and legal information.  
It is fully responsive and uses your global navigation data.

---

### Props

This component does not accept props.  
It automatically loads navigation links from \`src/data/navigation.ts\`.

---

### Behavior

- Displays navigation links, an About section, and copyright.
- Fully responsive using a 1–3 column grid.
- Uses semantic <footer> markup for accessibility.

---

### Usage Example

<Footer />
`;

import { navigation } from "../data/navigation";
const year = new Date().getFullYear();
---

<footer class="w-full border-t bg-gray-50 py-8 mt-12">
  <div class="max-w-6xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8">

    <div>
      <h2 class="text-lg font-semibold mb-3">Navigation</h2>
      <ul class="space-y-2">
        {navigation.map((item) => (
          <li>
            <a 
              href={item.href} 
              class="text-gray-700 hover:text-blue-600 transition"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="text-lg font-semibold mb-3">About</h2>
      <p class="text-gray-600 leading-relaxed">
        A clean, modern business website template built with Astro and Tailwind CSS.
      </p>
    </div>

    <div class="flex md:justify-end items-start">
      <p class="text-gray-600">
        © {year} Business Website. All rights reserved.
      </p>
    </div>

  </div>
</footer>
