---
import Button from "./Button.astro";
---

<!-- Chat panel -->
<div
  id="contact-chat-panel"
  class="hidden fixed bottom-6 right-6 z-50 w-[calc(100vw-3rem)] max-w-sm bg-white border border-gray-200 rounded-lg shadow-xl"
>
  <div class="flex items-center justify-between px-4 py-3 border-b border-gray-200">
    <h2 class="font-semibold text-gray-900">Message Me</h2>
    <button
      id="contact-chat-close"
      type="button"
      aria-label="Close chat"
      class="text-gray-500 hover:text-gray-800 text-2xl leading-none"
    >
      &times;
    </button>
  </div>

  <form id="contact-chat-form" class="p-4 space-y-4">
    <div>
      <label for="chat-name" class="block text-sm font-medium text-gray-700 mb-1">
        Name
      </label>
      <input
        type="text"
        id="chat-name"
        name="name"
        required
        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
    </div>

    <div>
      <label for="chat-email" class="block text-sm font-medium text-gray-700 mb-1">
        Email
      </label>
      <input
        type="email"
        id="chat-email"
        name="email"
        required
        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
    </div>

    <div>
      <label for="chat-message" class="block text-sm font-medium text-gray-700 mb-1">
        Message
      </label>
      <textarea
        id="chat-message"
        name="message"
        rows="4"
        required
        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
      ></textarea>
    </div>

    <Button variant="primary" fullWidth>Send Message</Button>
  </form>

  <p id="contact-chat-success" class="hidden mx-4 mb-4 p-3 bg-green-50 border border-green-200 text-green-800 rounded-md text-sm">
    Thanks for reaching out! Your message has been received and I'll get back to you soon.
  </p>
</div>

<script>
  const panel = document.getElementById("contact-chat-panel");
  const closeBtn = document.getElementById("contact-chat-close");
  const form = document.getElementById("contact-chat-form");
  const success = document.getElementById("contact-chat-success");
  let lastTrigger = null;

  // Genie morph: the panel grows out of the button that opened it (and shrinks back into it when closed).
  function openChat(trigger) {
    if (!panel) return;
    lastTrigger = trigger ?? null;
    panel.classList.remove("hidden");
    const btnRect = trigger?.getBoundingClientRect();
    if (!btnRect) return;
    const panelRect = panel.getBoundingClientRect();
    const dx = btnRect.left + btnRect.width / 2 - (panelRect.left + panelRect.width / 2);
    const dy = btnRect.top + btnRect.height / 2 - (panelRect.top + panelRect.height / 2);
    const sx = Math.max(btnRect.width / panelRect.width, 0.05);
    const sy = Math.max(btnRect.height / panelRect.height, 0.05);
    panel.style.transformOrigin = "center center";
    panel.style.transform = `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})`;
    panel.style.borderRadius = "999px";
    panel.style.opacity = "0";
    void panel.offsetWidth; // force the collapsed state to paint before animating
    const anim = panel.animate(
      [
        { transform: `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})`, borderRadius: "999px", opacity: 0 },
        { transform: "translate(0px, 0px) scale(1, 1)", borderRadius: "8px", opacity: 1 },
      ],
      { duration: 550, easing: "cubic-bezier(0.22, 1, 0.36, 1)", fill: "forwards" }
    );
    anim.onfinish = () => {
      panel.style.transform = "";
      panel.style.borderRadius = "";
      panel.style.opacity = "";
      panel.style.transformOrigin = "";
    };
  }

  function closeChat() {
    if (!panel) return;
    const btnRect = lastTrigger?.getBoundingClientRect();
    if (!btnRect) {
      panel.classList.add("hidden");
      return;
    }
    const panelRect = panel.getBoundingClientRect();
    const dx = btnRect.left + btnRect.width / 2 - (panelRect.left + panelRect.width / 2);
    const dy = btnRect.top + btnRect.height / 2 - (panelRect.top + panelRect.height / 2);
    const sx = Math.max(btnRect.width / panelRect.width, 0.05);
    const sy = Math.max(btnRect.height / panelRect.height, 0.05);
    panel.style.transformOrigin = "center center";
    const anim = panel.animate(
      [
        { transform: "translate(0px, 0px) scale(1, 1)", borderRadius: "8px", opacity: 1 },
        { transform: `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})`, borderRadius: "999px", opacity: 0 },
      ],
      { duration: 400, easing: "cubic-bezier(0.55, 0, 0.55, 0.2)", fill: "forwards" }
    );
    anim.onfinish = () => {
      panel.classList.add("hidden");
      panel.style.transformOrigin = "";
    };
  }

  closeBtn?.addEventListener("click", () => {
    closeChat();
  });

  // Any element with data-open-contact-chat opens the panel (e.g. the navbar Message Me button).
  document.addEventListener("click", (event) => {
    const target = event.target instanceof Element ? event.target.closest("[data-open-contact-chat]") : null;
    if (target) {
      event.preventDefault();
      if (!panel?.classList.contains("hidden")) {
        closeChat();
      } else {
        openChat(target);
      }
    }
  });

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    success?.classList.remove("hidden");
    const formEl = event.target;
    if (formEl instanceof HTMLFormElement) {
      formEl.reset();
    }
  });
</script>
