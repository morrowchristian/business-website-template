---
import Button from "./Button.astro";
---

<!-- Floating chat toggle button -->
<button
  id="contact-chat-toggle"
  type="button"
  aria-label="Open contact chat"
  class="fixed bottom-6 right-6 z-50 w-14 h-14 rounded-full bg-blue-600 text-white shadow-lg hover:bg-blue-700 transition flex items-center justify-center"
>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8-1.463 0-2.846-.305-4.06-.849L3 20l1.338-3.123C2.493 15.036 2 13.575 2 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
  </svg>
</button>

<!-- Chat panel -->
<div
  id="contact-chat-panel"
  class="hidden fixed bottom-24 right-6 z-50 w-[calc(100vw-3rem)] max-w-sm bg-white border border-gray-200 rounded-lg shadow-xl"
>
  <div class="flex items-center justify-between px-4 py-3 border-b border-gray-200">
    <h2 class="font-semibold text-gray-900">Contact Us</h2>
    <button
      id="contact-chat-close"
      type="button"
      aria-label="Close chat"
      class="text-gray-500 hover:text-gray-800 text-2xl leading-none"
    >
      &times;
    </button>
  </div>

  <form id="contact-chat-form" class="p-4 space-y-4">
    <div>
      <label for="chat-name" class="block text-sm font-medium text-gray-700 mb-1">
        Name
      </label>
      <input
        type="text"
        id="chat-name"
        name="name"
        required
        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
    </div>

    <div>
      <label for="chat-email" class="block text-sm font-medium text-gray-700 mb-1">
        Email
      </label>
      <input
        type="email"
        id="chat-email"
        name="email"
        required
        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
    </div>

    <div>
      <label for="chat-message" class="block text-sm font-medium text-gray-700 mb-1">
        Message
      </label>
      <textarea
        id="chat-message"
        name="message"
        rows="4"
        required
        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
      ></textarea>
    </div>

    <Button variant="primary" fullWidth>Send Message</Button>
  </form>

  <p id="contact-chat-success" class="hidden mx-4 mb-4 p-3 bg-green-50 border border-green-200 text-green-800 rounded-md text-sm">
    Thanks for reaching out! Your message has been received and we'll get back to you soon.
  </p>
</div>

<script>
  const toggle = document.getElementById("contact-chat-toggle");
  const panel = document.getElementById("contact-chat-panel");
  const closeBtn = document.getElementById("contact-chat-close");
  const form = document.getElementById("contact-chat-form");
  const success = document.getElementById("contact-chat-success");

  function openChat() {
    panel?.classList.remove("hidden");
  }

  toggle?.addEventListener("click", () => {
    panel?.classList.toggle("hidden");
  });

  closeBtn?.addEventListener("click", () => {
    panel?.classList.add("hidden");
  });

  // Any element with data-open-contact-chat opens the panel (e.g. the Hero's Contact Us button).
  document.addEventListener("click", (event) => {
    const target = event.target instanceof Element ? event.target.closest("[data-open-contact-chat]") : null;
    if (target) {
      event.preventDefault();
      openChat();
    }
  });

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    success?.classList.remove("hidden");
    const formEl = event.target;
    if (formEl instanceof HTMLFormElement) {
      formEl.reset();
    }
  });
</script>
