---
/**
 * PricingTable Component
 *
 * Purpose:
 * - Tiered pricing comparison for service/product plans.
 * - Highlights a recommended/featured tier.
 * - Per-tier feature lists with included/excluded markers.
 * - Optional monthly/yearly billing toggle.
 * - Responsive: stacks on mobile, columns on desktop.
 */

import Button from "./Button.astro";

export const docs = `
## PricingTable Component API

### Overview
The PricingTable component displays tiered plans side by side so visitors can compare price, features, and calls to action. One tier can be marked as featured (recommended) and is visually distinct.

---

### Props

| Prop            | Type    | Default | Description |
|-----------------|---------|---------|-------------|
| \`plans\`         | Plan[]  | —       | The pricing tiers to display. |
| \`columns\`       | 2 \| 3  | 3       | Columns on desktop. Mobile is always 1 column, tablet 2. |
| \`billingToggle\` | boolean | false   | When true, renders a Monthly/Yearly switch above the table. Selecting Yearly shows each plan's \`yearlyPrice\` (falling back to \`price\` when a plan has none). |

### Plan

| Field         | Type                                   | Description |
|---------------|----------------------------------------|-------------|
| \`name\`        | string                                 | Tier name (e.g. "Starter"). |
| \`price\`       | string                                 | Display price (e.g. "$49"). |
| \`yearlyPrice\` | string                                 | Price shown when the Yearly billing option is selected (e.g. "$490"). Optional — falls back to \`price\`. |
| \`period\`      | string                                 | Billing period (e.g. "/month"). Optional. |
| \`description\` | string                                 | Short tier summary. Optional. |
| \`features\`    | (string \\| { text: string, included?: boolean })[] | Feature list. Plain strings are included (check). An object with \`included: false\` renders with an x marker. |
| \`featured\`    | boolean                                | Marks the recommended tier. Optional. |
| \`cta\`         | { label: string, href: string }        | Call-to-action button. Optional. |

---

### Variants

| Variant | Description |
|---------|-------------|
| 3 columns (default) | Up to three tiers side by side on desktop. |
| 2 columns (\`columns={2}\`) | Two tiers side by side on desktop, centered — for simpler pricing. |
| Billing toggle (\`billingToggle\`) | A Monthly/Yearly switch above the table; yearly prices come from each plan's \`yearlyPrice\`. |

---

### Slots

| Slot    | Description |
|---------|-------------|
| none    | Content is provided entirely through the \`plans\` prop. |

---

### Behavior

- Renders plans in a responsive grid: 1 column on mobile, 2 on tablet, \`columns\` on desktop.
- The featured tier gets an accent border, a "Most Popular" badge, and an elevated shadow.
- Features render with a check (included) or an x (excluded) marker.
- CTAs use the Button component (primary for featured, secondary otherwise).
- With \`billingToggle\`, a Monthly/Yearly switch swaps each displayed price (and period) via a small vanilla script. Plans without a \`yearlyPrice\` keep showing their regular price.
- No framework hydration required.

---

### Usage Examples

<PricingTable plans={[
  { name: "Starter", price: "$29", period: "/month", description: "For new businesses getting online.", features: ["1-page website", "Contact form", { text: "Blog", included: false }], cta: { label: "Choose Starter", href: "/contact" } },
  { name: "Growth", price: "$79", period: "/month", description: "For growing businesses that need more.", features: ["Up to 5 pages", "Contact form", "Blog"], featured: true, cta: { label: "Choose Growth", href: "/contact" } },
]} />

<PricingTable columns={2} plans={[...]} />

<PricingTable billingToggle plans={[
  { name: "Starter", price: "$29", yearlyPrice: "$290", period: "/month", features: ["1-page website"] },
  { name: "Growth", price: "$79", yearlyPrice: "$790", period: "/month", features: ["Up to 5 pages"], featured: true },
]} />
`;

type Feature = string | { text: string; included?: boolean };

interface Plan {
  name: string;
  price: string;
  yearlyPrice?: string;
  period?: string;
  description?: string;
  features: Feature[];
  featured?: boolean;
  cta?: { label: string; href: string };
}

interface Props {
  plans: Plan[];
  columns?: 2 | 3;
  billingToggle?: boolean;
}

const { plans, columns = 3, billingToggle = false } = Astro.props;
const tableId = `pricing-${Math.random().toString(36).slice(2, 9)}`;

const gridCols =
  plans.length === 1
    ? "lg:grid-cols-1 lg:max-w-md lg:mx-auto"
    : columns === 2
      ? "lg:grid-cols-2 lg:max-w-3xl lg:mx-auto"
      : "lg:grid-cols-3";

function featureText(f: Feature): string {
  return typeof f === "string" ? f : f.text;
}
function featureIncluded(f: Feature): boolean {
  return typeof f === "string" ? true : (f.included ?? true);
}
---

<div id={tableId}>
  {billingToggle && (
    <div class="mb-6 flex justify-center">
      <div class="inline-flex rounded-full border border-gray-200 bg-gray-100 p-1" role="group" aria-label="Billing period">
        <button
          type="button"
          class="billing-btn rounded-full px-4 py-1.5 text-sm font-medium transition"
          data-billing="monthly"
          aria-pressed="true"
        >
          Monthly
        </button>
        <button
          type="button"
          class="billing-btn rounded-full px-4 py-1.5 text-sm font-medium transition"
          data-billing="yearly"
          aria-pressed="false"
        >
          Yearly
        </button>
      </div>
    </div>
  )}

  <div class={`grid grid-cols-1 md:grid-cols-2 ${gridCols} gap-6 items-stretch`}>
    {plans.map((plan) => (
      <div
        class={`relative flex flex-col rounded-xl border bg-white p-6 shadow-sm ${
          plan.featured
            ? "border-blue-600 ring-2 ring-blue-600 shadow-lg"
            : "border-gray-200"
        }`}
      >
        {plan.featured && (
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-blue-600 px-3 py-1 text-xs font-semibold text-white">
            Most Popular
          </span>
        )}

        <h3 class="text-lg font-semibold text-gray-900">{plan.name}</h3>
        {plan.description && (
          <p class="mt-1 text-sm text-gray-600">{plan.description}</p>
        )}

        <p class="mt-4 flex items-baseline gap-1">
          <span
            class="price-value text-4xl font-bold text-gray-900"
            data-monthly={plan.price}
            data-yearly={plan.yearlyPrice ?? plan.price}
          >
            {plan.price}
          </span>
          {plan.period && (
            <span
              class="price-period text-sm text-gray-500"
              data-monthly={plan.period}
              data-yearly={plan.yearlyPrice ? "/year" : plan.period}
            >
              {plan.period}
            </span>
          )}
        </p>

        <ul class="mt-6 flex-1 space-y-3">
          {plan.features.map((f) => (
            <li class="flex items-start gap-2 text-sm">
              {featureIncluded(f) ? (
                <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-4 w-4 shrink-0 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              ) : (
                <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-4 w-4 shrink-0 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              )}
              <span class={featureIncluded(f) ? "text-gray-700" : "text-gray-400 line-through"}>
                {featureText(f)}
              </span>
            </li>
          ))}
        </ul>

        {plan.cta && (
          <div class="mt-6">
            <Button
              href={plan.cta.href}
              variant={plan.featured ? "primary" : "secondary"}
              fullWidth
            >
              {plan.cta.label}
            </Button>
          </div>
        )}
      </div>
    ))}
  </div>
</div>

<script define:vars={{ tableId }}>
  const root = document.getElementById(tableId);
  if (root) {
    const buttons = Array.from(root.querySelectorAll(".billing-btn"));
    const prices = Array.from(root.querySelectorAll(".price-value"));
    const periods = Array.from(root.querySelectorAll(".price-period"));

    function setBilling(billing) {
      const yearly = billing === "yearly";
      prices.forEach((el) => {
        el.textContent = yearly ? el.dataset.yearly : el.dataset.monthly;
      });
      periods.forEach((el) => {
        el.textContent = yearly ? el.dataset.yearly : el.dataset.monthly;
      });
      buttons.forEach((btn) => {
        const active = btn.dataset.billing === billing;
        btn.setAttribute("aria-pressed", active ? "true" : "false");
        btn.classList.toggle("bg-white", active);
        btn.classList.toggle("text-gray-900", active);
        btn.classList.toggle("shadow-sm", active);
        btn.classList.toggle("text-gray-500", !active);
      });
    }

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => setBilling(btn.dataset.billing));
    });

    // Initialize the Monthly button's active styling.
    setBilling("monthly");
  }
</script>
