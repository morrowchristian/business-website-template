---
/**
 * Hero Component
 *
 * Purpose:
 * - Large headline + subtitle + default CTAs.
 */

const docs = `
## Hero Component API

### Overview
The Hero component displays a large, centered headline with supporting text and optional call‑to‑action buttons.

---

### Props

| Prop       | Type     | Default | Description |
|------------|----------|---------|-------------|
| \`title\`     | string   | "Build Your Business Presence" | Main headline text. |
| \`subtitle\`  | string   | A default marketing subtitle.  | Supporting description text. |

---

### Behavior

- Centers content with responsive typography.
- Includes two default CTA buttons.
- Fully customizable via props and slots (future‑friendly).

---

### Usage Example

<Hero 
  title="Grow Your Brand"
  subtitle="Modern tools to help your business thrive."
/>
`;

const {
  title = "Build Your Business Presence",
  subtitle = "A clean, modern template designed to help you launch fast and look professional."
} = Astro.props;
---

<section class="py-20 text-center">
  <h1 class="text-4xl md:text-5xl font-bold mb-4">
    {title}
  </h1>

  <p class="text-gray-600 max-w-xl mx-auto mb-8">
    {subtitle}
  </p>

  <div class="flex justify-center gap-4">
    <a 
      href="/services" 
      class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition"
    >
      Our Services
    </a>

    <a 
      href="/contact" 
      class="px-6 py-3 border border-gray-300 rounded-lg hover:bg-gray-100 transition"
    >
      Contact Us
    </a>
  </div>
</section>
