---
interface Props {
  href?: string | null;
  image?: string | null;
  title: string;
  description?: string;
}
const { href = null, image = null, title, description } = Astro.props;
---
<article class="rounded-lg border bg-white shadow-sm overflow-hidden">
  {image && (
    <img src={image} alt="" class="w-full h-48 object-cover" />
  )}

  <div class="p-4 space-y-2">
    <h3 class="text-lg font-semibold">{title}</h3>
    {description && <p class="text-gray-600">{description}</p>}
    <slot />
  </div>
</article>
