---
/**
 * BackButton Component
 *
 * Purpose:
 * - Consistent “back” navigation using Button or history.back().
 */

export const docs = `
## BackButton Component API

### Overview
The BackButton component provides consistent navigation back to a previous page or a specified URL.  
It wraps the core Button component and applies a standardized "back" visual style.

---

### Props

| Prop       | Type                | Default | Description |
|------------|---------------------|---------|-------------|
| \`href\`     | string \| null      | null    | When provided, navigates to the given URL instead of going back in history. |
| \`variant\`  | "text" \| "button"  | "text"  | "text" renders a plain link with an arrow; "button" renders an outlined button. |
| \`iconOnly\` | boolean             | false   | When true, renders only the back arrow, with no "Back" text (with an aria-label of "Back" for screen readers). |

---

### Variants

| Variant  | Style |
|----------|-------|
| \`text\`   | Plain link with a back arrow, as before. |
| \`button\` | Outlined button style (white background, blue border, blue text) with a back arrow. |
| \`iconOnly\` | Either variant with only the arrow and no text — useful in a header where space is tight. |

---

### Behavior

- If \`href\` is provided, the BackButton navigates to that URL.
- If no \`href\` is provided, it calls \`history.back()\`.
- The "text" variant uses the "ghost" button style when \`href\` is provided, and a plain text link otherwise.
- The "button" variant uses the "outline" button style when \`href\` is provided, and an outlined button otherwise.
- Includes a left‑aligned back arrow icon.

---

### Usage Examples

<BackButton href="/playground" />

<BackButton />

<BackButton href="/components" variant="button" />

<BackButton variant="button" />

<BackButton href="/components" variant="button" iconOnly />
`;

import Button from "./Button.astro";

interface Props {
  href?: string | null;
  variant?: "text" | "button";
  iconOnly?: boolean;
}

const { href = null, variant = "text", iconOnly = false } = Astro.props;

const isButton = variant === "button";
---

{href ? (
  <Button href={href} variant={isButton ? "outline" : "ghost"} icon="arrow_back" ariaLabel={iconOnly ? "Back" : null}>
    {!iconOnly && "Back"}
  </Button>
) : isButton ? (
  <button
    onclick="history.back()"
    aria-label={iconOnly ? "Back" : undefined}
    class="inline-flex items-center justify-center gap-2 px-4 py-2 text-base font-medium text-blue-600 bg-white border border-blue-600 rounded-md hover:bg-blue-50 transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
  >
    <span class="material-icons text-base">arrow_back</span>
    {!iconOnly && "Back"}
  </button>
) : (
  <button
    onclick="history.back()"
    aria-label={iconOnly ? "Back" : undefined}
    class="inline-flex items-center gap-2 text-gray-700 hover:text-gray-900"
  >
    <span class="material-icons text-base">arrow_back</span>
    {!iconOnly && "Back"}
  </button>
)}
