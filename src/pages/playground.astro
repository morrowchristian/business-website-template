---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import ButtonGroup from "../components/ButtonGroup.astro";
import Card from "../components/Card.astro";
import Hero from "../components/Hero.astro";
import { navigation } from "../data/navigation";
---

<BaseLayout title="Playground" description="Component and layout testing area">
  <h1 class="text-3xl font-bold mb-6">Playground</h1>

  <div class="space-y-12">
    <!-- Header Test -->
    <section>
      <p class="text-gray-600">
        The Header above should reflect the navigation data correctly.
      </p>
    </section>

    <!-- Hero Test -->
    <section>
      <h2 class="text-xl font-semibold mb-2">Hero Test</h2>
      <p class="text-gray-600 mb-4">The Hero component should render below.</p>
      <Hero />
    </section>

    <!-- Navigation Data -->
    <section>
      <h2 class="text-xl font-semibold mb-2">Navigation Data Test</h2>
      <ul class="list-disc pl-6 space-y-1">
        {navigation.map((item) => (
          <li>
            <a href={item.href} class="text-blue-600 hover:underline">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- Button Variants -->
    <section>
      <h2 class="text-xl font-semibold mb-2">Button Variants</h2>
      <p class="text-gray-600 mb-4">Testing primary, secondary, and outline variants.</p>

      <div class="flex flex-wrap gap-4">
        <Button variant="primary">Primary Button</Button>
        <Button variant="secondary">Secondary Button</Button>
        <Button variant="outline">Outline Button</Button>
      </div>
    </section>

    <!-- Button Sizes -->
    <section>
      <h2 class="text-xl font-semibold mb-2">Button Sizes</h2>
      <p class="text-gray-600 mb-4">Testing sm, md, and lg sizes.</p>

      <div class="flex flex-wrap gap-4">
        <Button size="sm">Small Button</Button>
        <Button size="md">Medium Button</Button>
        <Button size="lg">Large Button</Button>
      </div>
    </section>

    <!-- Full Width Buttons -->
    <section>
      <h2 class="text-xl font-semibold mb-2">Full‑Width Buttons</h2>
      <p class="text-gray-600 mb-4">Testing fullWidth behavior.</p>

      <div class="space-y-4">
        <Button fullWidth={true}>Full‑Width Primary</Button>
        <Button variant="secondary" fullWidth={true}>Full‑Width Secondary</Button>
        <Button variant="outline" fullWidth={true}>Full‑Width Outline</Button>
      </div>
    </section>

    <!-- Disabled Buttons -->
    <section>
      <h2 class="text-xl font-semibold mb-2">Disabled Buttons</h2>
      <p class="text-gray-600 mb-4">Testing disabled behavior for buttons and links.</p>

      <div class="flex flex-wrap gap-4">
        <Button disabled={true}>Disabled Primary</Button>
        <Button variant="secondary" disabled={true}>Disabled Secondary</Button>
        <Button variant="outline" disabled={true}>Disabled Outline</Button>
        <Button href="https://example.com" disabled={true}>Disabled Link Button</Button>
      </div>
    </section>

    <!-- Icon Support -->
    <section>
      <h2 class="text-xl font-semibold mb-2">Icon Support</h2>
      <p class="text-gray-600 mb-4">Testing leading and trailing icons.</p>

      <div class="flex flex-wrap gap-4">
        <Button variant="primary">
          <span slot="icon-left">🔥</span>
          Fire Button
        </Button>

        <Button variant="secondary">
          Next
          <span slot="icon-right">➡️</span>
        </Button>

        <Button variant="outline">
          <span slot="icon-left">⭐</span>
          Starred
          <span slot="icon-right">⭐</span>
        </Button>
      </div>
    </section>

    <!-- Loading State -->
    <section>
      <h2 class="text-xl font-semibold mb-2">Loading State</h2>
      <p class="text-gray-600 mb-4">Testing loading behavior with spinner and aria-live.</p>

      <div class="flex flex-wrap gap-4">
        <Button loading={true}>Loading Primary</Button>
        <Button variant="secondary" loading={true}>Loading Secondary</Button>
        <Button variant="outline" loading={true}>Loading Outline</Button>
        <Button href="https://example.com" loading={true}>Loading Link Button</Button>
      </div>
    </section>

    <!-- Button Groups -->
    <section>
      <h2 class="text-xl font-semibold mb-2">Button Groups</h2>
      <p class="text-gray-600 mb-4">Testing horizontal and vertical button groups.</p>

      <div class="space-y-8">
        <ButtonGroup>
          <Button variant="primary">Save</Button>
          <Button variant="secondary">Cancel</Button>
          <Button variant="outline">More</Button>
        </ButtonGroup>

        <ButtonGroup direction="vertical">
          <Button variant="primary">Continue</Button>
          <Button variant="secondary">Back</Button>
        </ButtonGroup>

        <ButtonGroup fullWidth={true}>
          <Button fullWidth={true} variant="primary">Submit</Button>
          <Button fullWidth={true} variant="outline">Reset</Button>
        </ButtonGroup>
      </div>
    </section>

    

    <!-- Card Component Test -->
    <section>
      <h2 class="text-xl font-semibold mb-2">Card Component Test</h2>
      <p class="text-gray-600 mb-4">Testing the base Card component structure.</p>

      <div class="max-w-sm">
        <Card
          image="/placeholder.jpg"
          title="Service Title"
          description="Short description of the service."
        >
          <Button variant="primary">Learn More</Button>
        </Card>
      </div>
    </section>

    <!-- Card Variants -->
    <section>
      <h2 class="text-xl font-semibold mb-2">Card Variants</h2>
      <p class="text-gray-600 mb-4">Testing base, horizontal, and minimal card layouts.</p>

      <div class="space-y-8">

        <!-- Base (image-top) -->
        <div>
          <h3 class="text-lg font-medium mb-2">Base Card</h3>
          <Card
            variant="base"
            image="/placeholder.jpg"
            title="Base Card"
            description="This is the default card layout with the image on top."
          >
            <Button variant="primary">Learn More</Button>
          </Card>
        </div>

        <!-- Horizontal -->
        <div>
          <h3 class="text-lg font-medium mb-2">Horizontal Card</h3>
          <Card
            variant="horizontal"
            image="/placeholder.jpg"
            title="Horizontal Card"
            description="Image on the left, content on the right."
          >
            <Button variant="secondary">Details</Button>
          </Card>
        </div>

        <!-- Minimal -->
        <div>
          <h3 class="text-lg font-medium mb-2">Minimal Card</h3>
          <Card
            variant="minimal"
            title="Minimal Card"
            description="A clean, text-first layout without borders or shadows."
          >
            <Button variant="outline">Action</Button>
          </Card>
        </div>

      </div>
    </section>

    <!-- Style Experiments -->
    <section>
      <h2 class="text-xl font-semibold mb-2">Style & Layout Experiments</h2>
      <div class="p-4 border rounded-lg bg-gray-50">
        <p class="text-gray-700">
          Use this area to test Tailwind classes, spacing, typography, etc.
        </p>
      </div>
    </section>

    <!-- Footer Test -->
    <section>
      <h2 class="text-xl font-semibold mb-2">Footer Test</h2>
      <p class="text-gray-600">Scroll down to verify the footer renders correctly.</p>
    </section>
  </div>
</BaseLayout>
