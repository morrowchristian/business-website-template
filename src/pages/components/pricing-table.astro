---
/**
 * PricingTable Component Explorer Page
 *
 * Purpose:
 * - Displays the PricingTable component's API documentation.
 * - Provides a live preview with 3 sample tiers.
 * - Shows the 2-column layout and billing toggle variants.
 * - Shows example usage code for reference.
 */

import ComponentExplorerLayout from "../../layouts/ComponentExplorerLayout.astro";
import PricingTableComponent, { docs } from "../../components/PricingTable.astro";
import CodeBlock from "../../components/CodeBlock.astro";

const samplePlans = [
  {
    name: "Starter",
    price: "$29",
    yearlyPrice: "$290",
    period: "/month",
    description: "For new businesses getting online.",
    features: [
      "1-page website",
      "Contact form",
      "Mobile-friendly design",
      { text: "Blog", included: false },
      { text: "Priority support", included: false }
    ],
    cta: { label: "Choose Starter", href: "/contact" }
  },
  {
    name: "Growth",
    price: "$79",
    yearlyPrice: "$790",
    period: "/month",
    description: "For growing businesses that need more.",
    features: [
      "Up to 5 pages",
      "Contact form",
      "Mobile-friendly design",
      "Blog",
      { text: "Priority support", included: false }
    ],
    featured: true,
    cta: { label: "Choose Growth", href: "/contact" }
  },
  {
    name: "Pro",
    price: "$149",
    yearlyPrice: "$1490",
    period: "/month",
    description: "For established businesses that want it all.",
    features: [
      "Unlimited pages",
      "Contact form",
      "Mobile-friendly design",
      "Blog",
      "Priority support"
    ],
    cta: { label: "Choose Pro", href: "/contact" }
  }
];

const twoPlans = [samplePlans[0], samplePlans[1]];
---

<ComponentExplorerLayout title="Pricing Table">

  <!-- Live Preview -->
  <section class="mb-12">
    <h2 class="text-xl font-semibold mb-4">Live Preview</h2>
    <p class="text-gray-600 mb-6">
      Three tiers with the middle one featured. Excluded features show an x marker and are struck through. The layout stacks on mobile and shows columns on desktop.
    </p>
    <PricingTableComponent plans={samplePlans} />
  </section>

  <!-- Variants -->
  <section class="mb-12">
    <h2 class="text-xl font-semibold mb-6">Variants</h2>

    <h3 class="text-lg font-medium mb-2">3 Columns (Default)</h3>
    <p class="text-gray-600 mb-4">
      Up to three tiers side by side on desktop, with the featured tier highlighted.
    </p>
    <div class="mb-4">
      <PricingTableComponent plans={samplePlans} />
    </div>
    <div class="mb-8">
      <CodeBlock code={`<PricingTable plans={plans} />`} language="astro" />
    </div>

    <h3 class="text-lg font-medium mb-2">2 Columns</h3>
    <p class="text-gray-600 mb-4">
      With <code class="font-mono text-sm bg-gray-100 px-1 rounded">columns={2}</code>, two tiers sit side by side and centered on desktop — for simpler pricing.
    </p>
    <div class="mb-4">
      <PricingTableComponent columns={2} plans={twoPlans} />
    </div>
    <div class="mb-8">
      <CodeBlock code={`<PricingTable columns={2} plans={plans} />`} language="astro" />
    </div>

    <h3 class="text-lg font-medium mb-2">Billing Toggle</h3>
    <p class="text-gray-600 mb-4">
      With <code class="font-mono text-sm bg-gray-100 px-1 rounded">billingToggle</code>, a Monthly/Yearly switch appears above the table. Selecting Yearly shows each plan's <code class="font-mono text-sm bg-gray-100 px-1 rounded">yearlyPrice</code> (plans without one keep their regular price). Try it:
    </p>
    <div class="mb-4">
      <PricingTableComponent billingToggle plans={samplePlans} />
    </div>
    <div class="mb-8">
      <CodeBlock code={`<PricingTable
  billingToggle
  plans={[
    {
      name: "Starter",
      price: "$29",
      yearlyPrice: "$290",
      period: "/month",
      description: "For new businesses getting online.",
      features: ["1-page website", "Contact form"],
      cta: { label: "Choose Starter", href: "/contact" },
    },
    {
      name: "Growth",
      price: "$79",
      yearlyPrice: "$790",
      period: "/month",
      description: "For growing businesses that need more.",
      features: ["Up to 5 pages", "Contact form", "Blog"],
      featured: true,
      cta: { label: "Choose Growth", href: "/contact" },
    },
  ]}
/>`} language="astro" />
    </div>
  </section>

  <!-- API Documentation -->
  <section class="mb-12">
    <h2 class="text-xl font-semibold mb-4">API Documentation</h2>
    <CodeBlock code={docs} language="markdown" />
  </section>

  <!-- Code Example -->
  <section class="mb-12">
    <h2 class="text-xl font-semibold mb-4">Code Example</h2>
    <CodeBlock code={`<PricingTable
  billingToggle
  plans={[
    {
      name: "Starter",
      price: "$29",
      yearlyPrice: "$290",
      period: "/month",
      description: "For new businesses getting online.",
      features: ["1-page website", "Contact form", { text: "Blog", included: false }],
      cta: { label: "Choose Starter", href: "/contact" },
    },
    {
      name: "Growth",
      price: "$79",
      yearlyPrice: "$790",
      period: "/month",
      description: "For growing businesses that need more.",
      features: ["Up to 5 pages", "Contact form", "Blog"],
      featured: true,
      cta: { label: "Choose Growth", href: "/contact" },
    },
  ]}
/>`} language="astro" />
  </section>

  <!-- Related Components -->
  <section>
    <h2 class="text-xl font-semibold mb-4">Related Components</h2>
    <ul class="list-disc list-inside space-y-2 text-gray-700">
      <li>
        <a href="/components/button" class="text-blue-600 hover:underline">Button</a>
        {" "}— the CTA buttons on each tier use the Button component.
      </li>
      <li>
        <a href="/components/card" class="text-blue-600 hover:underline">Card</a>
        {" "}— another content container for grouping related information.
      </li>
      <li>
        <a href="/components/faq-accordion" class="text-blue-600 hover:underline">FAQ Accordion</a>
        {" "}— the section that often sits below a pricing table to answer plan questions.
      </li>
    </ul>
  </section>

</ComponentExplorerLayout>
