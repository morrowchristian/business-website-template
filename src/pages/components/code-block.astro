---
/**
 * CodeBlock Component Explorer Page
 *
 * Purpose:
 * - Displays the CodeBlock component's API documentation.
 * - Provides live previews of dark/light themes, compact mode, and prop- vs slot-based usage.
 * - Shows related components.
 */

import ComponentExplorerLayout from "../../layouts/ComponentExplorerLayout.astro";
import CodeBlockComponent, { docs } from "../../components/CodeBlock.astro";
import Button from "../../components/Button.astro";

---

<ComponentExplorerLayout title="CodeBlock">

  <!-- Live Preview -->
  <section class="mb-12">
    <h2 class="text-xl font-semibold mb-4">Live Preview</h2>
    <p class="text-gray-600 mb-4">
      The default dark CodeBlock, with a language label and a CopyButton that copies the exact displayed code.
    </p>
    <CodeBlockComponent code={`<Button variant="primary">Save Changes</Button>`} language="astro" />
  </section>

  <!-- Variants -->
  <section class="mb-12">
    <h2 class="text-xl font-semibold mb-4">Variants</h2>

    <!-- Dark (default) -->
    <div class="mb-10">
      <h3 class="text-lg font-semibold mb-2">Dark (default)</h3>
      <p class="text-gray-600 mb-4">The classic code-editor look: dark gray block with light text.</p>
      <div class="mb-4">
        <CodeBlockComponent code={`<Button variant="primary">Save Changes</Button>`} language="astro" />
      </div>
      <CodeBlockComponent code={`<CodeBlock code='<Button variant="primary">Save Changes</Button>' language="astro" />`} language="astro" />
    </div>

    <!-- Light -->
    <div class="mb-10">
      <h3 class="text-lg font-semibold mb-2">Light</h3>
      <p class="text-gray-600 mb-4">Light gray background with dark text, for pages that need a softer code block.</p>
      <div class="mb-4">
        <CodeBlockComponent code={`<Button variant="primary">Save Changes</Button>`} language="astro" theme="light" />
      </div>
      <CodeBlockComponent code={`<CodeBlock code='<Button variant="primary">Save Changes</Button>' language="astro" theme="light" />`} language="astro" />
    </div>

    <!-- Compact -->
    <div class="mb-10">
      <h3 class="text-lg font-semibold mb-2">Compact</h3>
      <p class="text-gray-600 mb-4">Hides the header row (language label + CopyButton) — just the code, for inline or space-constrained displays.</p>
      <div class="mb-4">
        <CodeBlockComponent code={`npm run build`} language="bash" compact />
      </div>
      <CodeBlockComponent code={`<CodeBlock code="npm run build" language="bash" compact />`} language="astro" />
    </div>

    <!-- Light + Compact -->
    <div class="mb-10">
      <h3 class="text-lg font-semibold mb-2">Light + Compact</h3>
      <p class="text-gray-600 mb-4">The two new props combine: a light block with no header row.</p>
      <div class="mb-4">
        <CodeBlockComponent code={`npm run dev`} language="bash" theme="light" compact />
      </div>
      <CodeBlockComponent code={`<CodeBlock code="npm run dev" language="bash" theme="light" compact />`} language="astro" />
    </div>

    <!-- Slot-based -->
    <div class="mb-10">
      <h3 class="text-lg font-semibold mb-2">Slot-based</h3>
      <p class="text-gray-600 mb-4">
        Write multi-line code as slot content instead of the <code class="font-mono text-sm bg-gray-100 px-1 rounded">code</code> prop. Indentation is normalized automatically, so you can indent the example to match your page source.
      </p>
      <div class="mb-4">
        <CodeBlockComponent language="astro">
{`<Button variant="primary">Save Changes</Button>
<Button variant="secondary">Cancel</Button>
<Button variant="ghost">Learn More</Button>`}
        </CodeBlockComponent>
      </div>
      <p class="text-gray-600 mb-4">
        The buttons below are the live components from the slot example above.
      </p>
      <div class="space-y-6 mb-4">
        <Button variant="primary">Save Changes</Button>
        <Button variant="secondary">Cancel</Button>
        <Button variant="ghost">Learn More</Button>
      </div>
      <CodeBlockComponent code={`<CodeBlock language="astro">
  <Button variant="primary">Save Changes</Button>
  <Button variant="secondary">Cancel</Button>
  <Button variant="ghost">Learn More</Button>
</CodeBlock>`} language="astro" />
    </div>
  </section>

  <!-- API Documentation -->
  <section class="mb-12">
    <h2 class="text-xl font-semibold mb-4">API Documentation</h2>
    <CodeBlockComponent code={docs} language="markdown" />
  </section>

  <!-- Code Example -->
  <section class="mb-12">
    <h2 class="text-xl font-semibold mb-4">Code Example</h2>
    <CodeBlockComponent code={`<CodeBlock language="astro" theme="light">
  <Button variant="primary">Save Changes</Button>
  <Button variant="secondary">Cancel</Button>
</CodeBlock>`} language="astro" />
  </section>

  <!-- Related Components -->
  <section>
    <h2 class="text-xl font-semibold mb-4">Related Components</h2>
    <ul class="list-disc list-inside space-y-2 text-gray-700">
      <li>
        <a href="/components/copy-button" class="text-blue-600 hover:underline">CopyButton</a>
        {" "}— the small copy button rendered in the top-right corner of every CodeBlock. It copies the block's code and briefly shows "Copied!".
      </li>
      <li>
        <a href="/components/button" class="text-blue-600 hover:underline">Button</a>
        {" "}— the component used in the examples above.
      </li>
      <li>
        <a href="/components/card" class="text-blue-600 hover:underline">Card</a>
        {" "}— another component whose explorer page now uses CodeBlock for its code samples.
      </li>
    </ul>
  </section>

</ComponentExplorerLayout>
