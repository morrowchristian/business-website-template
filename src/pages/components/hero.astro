---
/**
 * Hero Component Explorer Page
 */

import ComponentExplorerLayout from "../../layouts/ComponentExplorerLayout.astro";
import HeroComponent from "../../components/Hero.astro";

const docs = (HeroComponent as any).__astro_internal?.docs ?? "No documentation available.";

export const title = "Hero"

export const related = [
  { name: "Header", href: "/components/header" },
  { name: "Button", href: "/components/button" }
];
---

<ComponentExplorerLayout title={title} related={related}>

  <!-- API Documentation -->
  <section class="prose max-w-none mb-12">
    <h2>API Documentation</h2>
    <pre class="bg-gray-100 p-4 rounded whitespace-pre-wrap text-sm">{docs}</pre>
  </section>

  <!-- Live Preview -->
  <section class="mb-12">
    <h2 class="text-xl font-semibold mb-4">Live Preview</h2>

    <HeroComponent />

    <HeroComponent 
      title="Grow Your Brand"
      subtitle="Modern tools to help your business thrive."
    />
  </section>

  <!-- Code Example -->
  <section>
    <h2 class="text-xl font-semibold mb-4">Code Example</h2>
    <pre class="bg-gray-100 p-4 rounded text-sm">
    {`<Hero 
      title="Grow Your Brand"
      subtitle="Modern tools to help your business thrive."
    />`}
    </pre>
  </section>

</ComponentExplorerLayout>
