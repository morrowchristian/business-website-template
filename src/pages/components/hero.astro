---
/**
 * Hero Component Explorer Page
 *
 * Purpose:
 * - Demonstrates the Hero component with default and custom props.
 * - Displays API documentation and usage example.
 */

import ComponentExplorerLayout from "../../layouts/ComponentExplorerLayout.astro";
import HeroComponent from "../../components/Hero.astro";

// Access internal docs safely with a type cast
const docs = (HeroComponent as any).__astro_internal?.docs ?? "No documentation available.";
---

<ComponentExplorerLayout title="Hero">

  <!-- API Documentation -->
  <section class="prose max-w-none mb-12">
    <h2>API Documentation</h2>
    <pre class="bg-gray-100 p-4 rounded whitespace-pre-wrap text-sm">{docs}</pre>
  </section>

  <!-- Live Preview -->
  <section class="mb-12">
    <h2 class="text-xl font-semibold mb-4">Live Preview</h2>

    <HeroComponent />

    <HeroComponent 
      title="Grow Your Brand"
      subtitle="Modern tools to help your business thrive."
    />
  </section>

  <!-- Code Example -->
  <section>
    <h2 class="text-xl font-semibold mb-4">Code Example</h2>
    <pre class="bg-gray-100 p-4 rounded text-sm">
    {`<Hero 
      title="Grow Your Brand"
      subtitle="Modern tools to help your business thrive."
    />`}
    </pre>
  </section>

  <!-- Related Components -->
  <section class="mt-16 pt-8 border-t border-slate-200">
    <h2 class="text-xl font-semibold mb-4">Related Components</h2>
    <ul class="space-y-2 text-blue-600">
      <li><a href="/components/header" class="hover:underline">Header &rarr;</a></li>
      <li><a href="/components/button" class="hover:underline">Button &rarr;</a></li>
    </ul>
  </section>

</ComponentExplorerLayout>
