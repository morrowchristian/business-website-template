---
/**
 * ButtonGroup Component Explorer Page
 */

import ComponentExplorerLayout from "../../layouts/ComponentExplorerLayout.astro";
import ButtonGroupComponent from "../../components/ButtonGroup.astro";
import Button from "../../components/Button.astro";

const docs = (ButtonGroupComponent as any).__astro_internal?.docs ?? "No documentation available.";

export const title = "Button Group";

export const related = [
  { name: "Button", href: "/components/button" },
  { name: "Back Button", href: "/components/back-button" },
  { name: "Copy Button", href: "/components/copy-button" }
];

---

<ComponentExplorerLayout title={title} related={related}>

  <!-- API Documentation -->
  <section class="prose max-w-none mb-12">
    <h2>API Documentation</h2>
    <pre class="bg-gray-100 p-4 rounded whitespace-pre-wrap text-sm">{docs}</pre>
  </section>

  <!-- Live Preview -->
  <section class="mb-12">
    <h2 class="text-xl font-semibold mb-4">Live Preview</h2>

    <div class="space-y-8">

      <!-- Horizontal -->
      <ButtonGroupComponent>
        <Button>Save</Button>
        <Button variant="secondary">Cancel</Button>
      </ButtonGroupComponent>

      <!-- Vertical -->
      <ButtonGroupComponent direction="vertical">
        <Button>Top</Button>
        <Button>Middle</Button>
        <Button>Bottom</Button>
      </ButtonGroupComponent>

      <!-- Full Width -->
      <ButtonGroupComponent fullWidth gap="gap-4">
        <Button fullWidth>Full Width A</Button>
        <Button fullWidth>Full Width B</Button>
      </ButtonGroupComponent>

    </div>
  </section>

  <!-- Code Example -->
  <section>
    <h2 class="text-xl font-semibold mb-4">Code Example</h2>
    <pre class="bg-gray-100 p-4 rounded text-sm">
    {`<ButtonGroup direction="horizontal" gap="gap-4">
      <Button>Save</Button>
      <Button variant="secondary">Cancel</Button>
    </ButtonGroup>`}
    </pre>
  </section>

</ComponentExplorerLayout>