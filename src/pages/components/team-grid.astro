---
/**
 * TeamGrid Component Explorer Page
 *
 * Purpose:
 * - Displays the TeamGrid component's API documentation.
 * - Provides a live preview with sample members.
 * - Shows the default, compact, and circle card styles, plus the 4-column layout.
 * - Shows example usage code for reference.
 *
 * Note: the members below are sample/placeholder content used to
 * demonstrate the component. Real team members replace them
 * when the component is used on a business site.
 */

import ComponentExplorerLayout from "../../layouts/ComponentExplorerLayout.astro";
import TeamGridComponent, { docs } from "../../components/TeamGrid.astro";
import CodeBlock from "../../components/CodeBlock.astro";

const sampleMembers = [
  {
    name: "Alex Rivera",
    role: "Founder & CEO",
    bio: "Started the company in 2018 after a decade in the trade. Still on every first install.",
    socials: [
      { label: "LinkedIn", href: "https://linkedin.com" },
      { label: "Email", href: "mailto:alex@example.com" }
    ]
  },
  {
    name: "Sam Chen",
    role: "Lead Installer",
    bio: "Certified installer with 200+ projects completed. Leads the crew on every large job.",
    socials: [{ label: "LinkedIn", href: "https://linkedin.com" }]
  },
  {
    name: "Jordan Lee",
    role: "Customer Success",
    bio: "First point of contact for quotes and scheduling. Keeps every project on track.",
    socials: [{ label: "Email", href: "mailto:jordan@example.com" }]
  }
];

const fourMembers = [
  ...sampleMembers,
  { name: "Casey Brooks", role: "Design Lead", bio: "Owns the look and feel of every site we ship.", socials: [{ label: "LinkedIn", href: "https://linkedin.com" }] }
];
---

<ComponentExplorerLayout title="Team Grid">

  <!-- Live Preview -->
  <section class="mb-12">
    <h2 class="text-xl font-semibold mb-4">Live Preview</h2>
    <p class="text-gray-600 mb-6">
      Sample team members (placeholder content). No photos are provided here, so each card shows an initial placeholder. The grid is 1 column on mobile, 2 on tablet, and 3 on desktop.
    </p>
    <TeamGridComponent members={sampleMembers} />
  </section>

  <!-- Variants -->
  <section class="mb-12">
    <h2 class="text-xl font-semibold mb-4">Variants</h2>

    <h3 class="text-lg font-medium mb-2">Default — Photo on Top</h3>
    <p class="text-gray-600 mb-4">
      The classic team card: a square photo on top, name, role, bio, and social links below.
    </p>
    <div class="mb-4">
      <TeamGridComponent members={sampleMembers} />
    </div>
    <div class="mb-8">
      <CodeBlock code={`<TeamGrid members={members} />`} language="astro" />
    </div>

    <h3 class="text-lg font-medium mb-2">Compact</h3>
    <p class="text-gray-600 mb-4">
      A smaller card with the photo on the left and the text on the right — for denser team sections.
    </p>
    <div class="mb-4">
      <TeamGridComponent cardStyle="compact" members={sampleMembers} />
    </div>
    <div class="mb-8">
      <CodeBlock code={`<TeamGrid cardStyle="compact" members={members} />`} language="astro" />
    </div>

    <h3 class="text-lg font-medium mb-2">Circle</h3>
    <p class="text-gray-600 mb-4">
      A round photo centered above centered text.
    </p>
    <div class="mb-4">
      <TeamGridComponent cardStyle="circle" members={sampleMembers} />
    </div>
    <div class="mb-8">
      <CodeBlock code={`<TeamGrid cardStyle="circle" members={members} />`} language="astro" />
    </div>

    <h3 class="text-lg font-medium mb-2">4 Columns</h3>
    <p class="text-gray-600 mb-4">
      With <code class="font-mono text-sm bg-gray-100 px-1 rounded">columns={4}</code>, the grid shows 4 cards per row on desktop. Works with any card style.
    </p>
    <div class="mb-4">
      <TeamGridComponent members={fourMembers} columns={4} />
    </div>
    <div class="mb-8">
      <CodeBlock code={`<TeamGrid columns={4} members={members} />`} language="astro" />
    </div>
  </section>

  <!-- API Documentation -->
  <section class="mb-12">
    <h2 class="text-xl font-semibold mb-4">API Documentation</h2>
    <CodeBlock code={docs} language="markdown" />
  </section>

  <!-- Code Example -->
  <section class="mb-12">
    <h2 class="text-xl font-semibold mb-4">Code Example</h2>
    <CodeBlock code={`<TeamGrid
  members={[
    {
      name: "Alex Rivera",
      role: "Founder & CEO",
      bio: "Started the company in 2018 after a decade in the trade.",
      socials: [{ label: "LinkedIn", href: "https://linkedin.com" }],
    },
    {
      name: "Sam Chen",
      role: "Lead Installer",
      bio: "Certified installer with 200+ projects completed.",
    },
  ]}
/>`} language="astro" />
  </section>

  <!-- Related Components -->
  <section>
    <h2 class="text-xl font-semibold mb-4">Related Components</h2>
    <ul class="list-disc list-inside space-y-2 text-gray-700">
      <li>
        <a href="/components/card" class="text-blue-600 hover:underline">Card</a>
        {" "}— another content container; TeamGrid cards are a specialized variant.
      </li>
      <li>
        <a href="/components/testimonial-carousel" class="text-blue-600 hover:underline">Testimonial Carousel</a>
        {" "}— the social-proof module that often sits near a team section.
      </li>
      <li>
        <a href="/components/code-block" class="text-blue-600 hover:underline">CodeBlock</a>
        {" "}— used on this page to display the API docs and code example.
      </li>
    </ul>
  </section>

</ComponentExplorerLayout>
