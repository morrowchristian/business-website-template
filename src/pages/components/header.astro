---
/**
 * Header Component Explorer Page
 *
 * Purpose:
 * - Displays the global Header component.
 * - Shows API documentation and usage example.
 */

import ComponentExplorerLayout from "../../layouts/ComponentExplorerLayout.astro";
import HeaderComponent, { docs } from "../../components/Header.astro";
import CodeBlock from "../../components/CodeBlock.astro";

---

<ComponentExplorerLayout title="Header">

  <!-- API Documentation -->
  <section class="prose max-w-none mb-12">
    <h2>API Documentation</h2>
    <CodeBlock code={docs} language="markdown" />
  </section>

  <!-- Live Preview -->
  <section class="mb-12">
    <h2 class="text-xl font-semibold mb-4">Live Preview</h2>

    <HeaderComponent />
  </section>

  <!-- Code Example -->
  <section>
    <h2 class="text-xl font-semibold mb-4">Code Example</h2>
    <CodeBlock code={`<Header />`} language="astro" />
  </section>

</ComponentExplorerLayout>
