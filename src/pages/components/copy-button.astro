---
/**
 * CopyButton Component Explorer Page
 *
 * Purpose:
 * - Demonstrates the CopyButton component in isolation.
 * - Shows how the component hydrates and interacts with a code block.
 * - Displays API documentation extracted from the component file.
 */

import ComponentExplorerLayout from "../../layouts/ComponentExplorerLayout.astro";
import CopyButtonComponent from "../../components/CopyButton.tsx";

// Access internal docs safely with a type cast
const docs = (CopyButtonComponent as any).__astro_internal?.docs ?? "No documentation available.";

// Unique ID for the <pre> block so CopyButton knows what to copy
const exampleId = "copy-button-example";
---

<ComponentExplorerLayout title="CopyButton">

  <!-- API Documentation -->
  <section class="prose max-w-none mb-12">
    <h2>API Documentation</h2>
    <pre class="bg-gray-100 p-4 rounded whitespace-pre-wrap text-sm">{docs}</pre>
  </section>

  <!-- Live Preview -->
  <section class="mb-12">
    <h2 class="text-xl font-semibold mb-4">Live Preview</h2>

    <div class="relative">
      <!-- Hydrated CopyButton -->
      <CopyButtonComponent targetId={exampleId} client:load />

      <!-- Target code block -->
      <pre id={exampleId} class="bg-gray-100 p-4 rounded text-sm">
      {`<div>Hello world</div>`}
      </pre>

      <script>
        console.log("Explorer page loaded");
        console.log("Pre element:", document.getElementById("copy-button-example"));
      </script>
    </div>
  </section>

</ComponentExplorerLayout>
