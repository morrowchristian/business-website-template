---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Card from "../components/Card.astro";
import { services } from "../data/services";
---


<BaseLayout
  title="Services"
  description="Explore the services we offer — from web development and design to consulting and ongoing support."
>
  <Hero
    title="Our Services"
    subtitle="Everything your business needs to look professional online — built with modern tools and a focus on results."
  />

  <section class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {services.map((service) => (
      <Card
        title={service.title}
        description={service.description}
      />
    ))}
  </section>
</BaseLayout>
