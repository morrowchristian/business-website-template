---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import ButtonGroup from "../../components/ButtonGroup.astro";
---

<BaseLayout title="Button Playground" description="Testing all Button variants and states">
  <h1 class="text-3xl font-bold mb-6">Buttons</h1>

  <div class="space-y-12">

    <!-- Variants -->
    <section>
      <h2 class="text-xl font-semibold mb-2">Variants</h2>
      <div class="flex flex-wrap gap-4">
        <Button variant="primary">Primary</Button>
        <Button variant="secondary">Secondary</Button>
        <Button variant="outline">Outline</Button>
      </div>
    </section>

    <!-- Sizes -->
    <section>
      <h2 class="text-xl font-semibold mb-2">Sizes</h2>
      <div class="flex flex-wrap gap-4">
        <Button size="sm">Small</Button>
        <Button size="md">Medium</Button>
        <Button size="lg">Large</Button>
      </div>
    </section>

    <!-- Full Width -->
    <section>
      <h2 class="text-xl font-semibold mb-2">Full Width</h2>
      <div class="space-y-4">
        <Button fullWidth={true}>Full Width</Button>
        <Button variant="secondary" fullWidth={true}>Secondary Full Width</Button>
      </div>
    </section>

    <!-- Disabled -->
    <section>
      <h2 class="text-xl font-semibold mb-2">Disabled</h2>
      <div class="flex flex-wrap gap-4">
        <Button disabled={true}>Disabled</Button>
        <Button variant="secondary" disabled={true}>Disabled Secondary</Button>
      </div>
    </section>

    <!-- Icons -->
    <section>
      <h2 class="text-xl font-semibold mb-2">Icon Support</h2>
      <div class="flex flex-wrap gap-4">
        <Button><span slot="icon-left">🔥</span>Fire</Button>
        <Button variant="secondary">Next<span slot="icon-right">➡️</span></Button>
      </div>
    </section>

    <!-- Loading -->
    <section>
      <h2 class="text-xl font-semibold mb-2">Loading</h2>
      <div class="flex flex-wrap gap-4">
        <Button loading={true}>Loading</Button>
        <Button variant="secondary" loading={true}>Loading Secondary</Button>
      </div>
    </section>

    <!-- Groups -->
    <section>
      <h2 class="text-xl font-semibold mb-2">Button Groups</h2>
      <ButtonGroup>
        <Button variant="primary">Save</Button>
        <Button variant="secondary">Cancel</Button>
      </ButtonGroup>
    </section>

  </div>
</BaseLayout>
