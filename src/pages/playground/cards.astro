---
import BackButton from "../../components/BackButton.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/Card.astro";
import Button from "../../components/Button.astro";
---

<BaseLayout title="Card Playground" description="Testing all Card variants and states">
  <BackButton href="/playground" />
  <h1 class="text-3xl font-bold mb-6">Cards</h1>

  <div class="space-y-12">

    <!-- Base -->
    <section>
      <h2 class="text-xl font-semibold mb-2">Base Card</h2>
      <Card
        variant="base"
        image="/placeholder.jpg"
        title="Base Card"
        description="Default image-top layout."
      >
        <Button variant="primary">Learn More</Button>
      </Card>
    </section>

    <!-- Horizontal -->
    <section>
      <h2 class="text-xl font-semibold mb-2">Horizontal Card</h2>
      <Card
        variant="horizontal"
        image="/placeholder.jpg"
        title="Horizontal Card"
        description="Image left, content right."
      >
        <Button variant="secondary">Details</Button>
      </Card>
    </section>

    <!-- Minimal -->
    <section>
      <h2 class="text-xl font-semibold mb-2">Minimal Card</h2>
      <Card
        variant="minimal"
        title="Minimal Card"
        description="Text-first layout."
      />
    </section>

  </div>
</BaseLayout>
