---
import BackButton from "../../components/BackButton.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { navigation } from "../../data/navigation";
---

<BaseLayout title="Navigation Playground" description="Testing navigation data and header behavior">
  <BackButton href="/playground" />
  <h1 class="text-3xl font-bold mb-6">Navigation</h1>

  <section class="space-y-6">
    <p class="text-gray-600">
      This page tests the navigation data and how it renders in the Header.
    </p>

    <!-- Navigation Data -->
    <div>
      <h2 class="text-xl font-semibold mb-2">Navigation Data</h2>
      <ul class="list-disc pl-6 space-y-1">
        {navigation.map((item) => (
          <li>
            <a href={item.href} class="text-blue-600 hover:underline">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Header Test -->
    <p class="text-gray-500 italic">
      The Header above should reflect the navigation data.
    </p>
  </section>
</BaseLayout>
