---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout 
  title="Business Website" 
  description="Professional business website template built with Astro"
>
  <h1 class="text-5xl font-extrabold mb-4">Astro</h1>
  <p class="text-gray-600 text-xl mb-8">
    A clean, modern starting point for a business website and component design system.
  </p>

  <a 
    href="/components" 
    class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg shadow hover:bg-blue-700 transition"
  >
    Open Component Explorer
  </a>
</BaseLayout>
