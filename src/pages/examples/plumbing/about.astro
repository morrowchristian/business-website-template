---
/**
 * Cedar Creek Plumbing — About (example site)
 *
 * Purpose:
 * - Example Local Service about page: company story + team.
 * - All people, dates, and copy are fictional/placeholder content.
 */

import ExampleLayout from "../../../layouts/ExampleLayout.astro";
import Card from "../../../components/Card.astro";
import TeamGrid from "../../../components/TeamGrid.astro";

const members = [
  {
    name: "Marcus Webb",
    role: "Owner & Master Plumber",
    bio: "Started Cedar Creek in 2012 after 15 years in the trade. Still takes calls on the emergency line and still believes a job isn't done until the customer would recommend us."
  },
  {
    name: "Priya Nair",
    role: "Lead Technician",
    bio: "Leads our install and repair crews. Specializes in tankless water heaters and sewer camera work — and in explaining the fix in plain language before starting."
  },
  {
    name: "Tom Okafor",
    role: "Office Manager",
    bio: "The voice you'll hear when you call. Schedules jobs, answers questions, and makes sure the crew shows up when promised — on time, every time."
  }
];
---

<ExampleLayout
  title="About — Cedar Creek Plumbing"
  description="Cedar Creek Plumbing is a fictional local plumbing company in Cleveland, TN. Learn about the team and how the business works — an example site built from the business-website-template components."
>
  <h1 class="text-3xl font-bold mb-4">About Cedar Creek Plumbing</h1>
  <p class="text-gray-600 mb-8 max-w-3xl">
    A fictional local plumbing company — this page shows how an About page can
    tell a small business's story and introduce its team.
  </p>

  <!-- Story -->
  <section class="mb-12 max-w-3xl space-y-4 text-gray-700 leading-relaxed">
    <p>
      Cedar Creek Plumbing started in 2012 with one van, one plumber, and a
      simple rule: treat every home like it's your own. Fourteen years later
      the fleet is bigger, but the rule hasn't changed.
    </p>
    <p>
      We're a local, family-owned shop serving Cleveland, TN and the
      surrounding towns. No call centers, no subcontractors you didn't ask
      for — the person who answers the phone is the person who schedules your
      job, and the plumber who shows up is the one who does the work.
    </p>
    <p>
      We're fully licensed and insured, and every job is backed by a 1-year
      workmanship guarantee. If something we fixed fails within a year, we
      come back and make it right at no charge.
    </p>
  </section>

  <!-- Values -->
  <section class="mb-12">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <Card
        title="Licensed & Insured"
        description="Fully licensed and insured, with a 1-year workmanship guarantee on every job."
      />
      <Card
        title="Local & Family-Owned"
        description="Based in Cleveland, TN. The people you talk to are the people who do the work."
      />
      <Card
        title="Upfront Pricing"
        description="Free estimates and a flat price before we start — no hourly meters running, no surprises."
      />
    </div>
  </section>

  <!-- Team -->
  <section>
    <h2 class="text-2xl font-semibold mb-2">Meet the team</h2>
    <p class="text-gray-600 mb-6">
      Placeholder team members — replace these with the real crew.
    </p>
    <TeamGrid members={members} />
  </section>
</ExampleLayout>
