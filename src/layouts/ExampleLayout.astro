---
/**
 * ExampleLayout
 *
 * Purpose:
 * - Layout for the Cedar Creek Plumbing example site only.
 * - Gives the example its own header (business name + example nav + call
 *   button) and footer (contact details, hours, fictional-demo note).
 * - Does NOT reuse the template's Header/Footer, which show the template
 *   nav (Components, Examples, Guides).
 * - Includes ContactChat so the "Message Us" button and the Hero's
 *   "Contact Us" button open the message panel on every example page.
 * - A BackButton in the header takes visitors back to the template
 *   (Components explorer) from any example page.
 */

import "../styles/global.css";
import BackButton from "../components/BackButton.astro";
import Button from "../components/Button.astro";
import ContactChat from "../components/ContactChat.astro";

const {
  title = "Cedar Creek Plumbing",
  description = "Cedar Creek Plumbing — a fictional local plumbing company, built as an example site from the business-website-template components."
} = Astro.props;

const navLinks = [
  { label: "Home", href: "/examples/plumbing/" },
  { label: "Services", href: "/examples/plumbing/services" },
  { label: "About", href: "/examples/plumbing/about" },
  { label: "Reviews", href: "/examples/plumbing/reviews" },
  { label: "Contact", href: "/examples/plumbing/contact" }
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => currentPath === href.replace(/\/$/, "");
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body class="min-h-screen flex flex-col text-gray-900 bg-white antialiased">
    <header class="w-full border-b bg-white">
      <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center gap-x-6 gap-y-3 px-4 py-4">
        <BackButton href="/components" variant="button" iconOnly />

        <a href="/examples/plumbing/" class="text-xl font-bold text-gray-900">
          Cedar Creek <span class="text-blue-600">Plumbing</span>
        </a>

        <nav class="flex flex-wrap items-center gap-x-5 gap-y-2" aria-label="Example site">
          {navLinks.map((link) => (
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class={`text-sm font-medium transition ${
                isActive(link.href)
                  ? "text-blue-700 font-semibold"
                  : "text-gray-700 hover:text-blue-600"
              }`}
            >
              {link.label}
            </a>
          ))}
        </nav>

        <div class="ml-auto flex flex-wrap items-center gap-2">
          <button
            type="button"
            data-open-contact-chat
            class="inline-flex items-center justify-center rounded-md px-4 py-2 text-base font-medium text-gray-700 transition-colors hover:bg-gray-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
          >
            Message Us
          </button>
          <Button href="tel:+14235550147" variant="primary" size="sm">
            Call (423) 555-0147
          </Button>
        </div>
      </div>
    </header>

    <main class="flex-1 w-full max-w-6xl mx-auto px-4 py-8">
      <slot />
    </main>

    <footer class="w-full border-t bg-gray-50 py-8 mt-12">
      <div class="mx-auto w-full max-w-6xl px-4">
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
          <div>
            <p class="font-bold text-gray-900">Cedar Creek Plumbing</p>
            <p class="mt-1 text-sm text-gray-600">
              Local plumbing for Cleveland, TN and surrounding areas.
            </p>
          </div>
          <div>
            <p class="font-semibold text-gray-900">Contact</p>
            <p class="mt-1 text-sm text-gray-600">
              <a href="tel:+14235550147" class="text-blue-600 hover:underline">(423) 555-0147</a>
              <br />
              <a href="mailto:hello@cedarcreekplumbing.example" class="text-blue-600 hover:underline">hello@cedarcreekplumbing.example</a>
            </p>
          </div>
          <div>
            <p class="font-semibold text-gray-900">Hours</p>
            <p class="mt-1 text-sm text-gray-600">
              Mon–Fri 7am–6pm<br />
              Sat 8am–2pm<br />
              24/7 emergency line
            </p>
          </div>
        </div>

        <p class="mt-6 border-t border-gray-200 pt-4 text-xs text-gray-500">
          Cedar Creek Plumbing is a fictional demo business built with the
          business-website-template components. The phone number and email are
          placeholders. <a href="/components" class="text-blue-600 hover:underline">Back to template</a>
        </p>
      </div>
    </footer>

    <ContactChat />
  </body>
</html>
