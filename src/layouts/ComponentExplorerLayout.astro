---
/**
 * ComponentExplorerLayout
 *
 * Purpose:
 * - Storybook-style layout with sidebar + main content.
 * - Provides a modern, centered app shell for the design system.
 */

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

// Category-based navigation structure
const categories = [
  {
    label: "Buttons",
    items: [
      { name: "Button", href: "/components/button" },
      { name: "Button Group", href: "/components/button-group" },
      { name: "Back Button", href: "/components/back-button" },
      { name: "Copy Button", href: "/components/copy-button" }
    ]
  },
  {
    label: "Cards",
    items: [
      { name: "Card", href: "/components/card" }
    ]
  },
  {
    label: "Layout",
    items: [
      { name: "Header", href: "/components/header" },
      { name: "Hero", href: "/components/hero" },
      { name: "Footer", href: "/components/footer" }
    ]
  }
];
---
<!-- App Background -->
<div class="min-h-screen bg-slate-100 flex justify-center">

  <!-- App Shell -->
  <div class="flex w-full max-w-6xl bg-white shadow-md border border-slate-200 mt-10 mb-10 rounded-xl overflow-hidden">

    <!-- Sidebar -->
    <aside class="w-64 shrink-0 border-r bg-slate-50 p-6">
      <h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wide mb-4">
        Components
      </h2>

      <a
        href="/components"
        class="block px-3 py-2 rounded-md text-sm font-medium text-slate-700 hover:bg-slate-200 mb-4"
      >
        Home
      </a>

      <nav class="space-y-6">
        {categories.map((category) => (
          <div>
            <!-- Category Header (Option 1 styling) -->
            <h3 class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-2">
              {category.label}
            </h3>

            <ul class="space-y-1">
              {category.items.map((item) => {
                const isActive = currentPath === item.href;

                return (
                  <li>
                    <a
                      href={item.href}
                      class={`block px-3 py-2 rounded-md text-sm transition
                        ${isActive
                          ? "bg-slate-900 text-white font-medium"
                          : "text-slate-700 hover:bg-slate-200"
                        }
                      `}
                    >
                      {item.name}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 p-10">
      <h1 class="text-2xl font-semibold mb-6 text-slate-900">{title}</h1>
      <div class="text-slate-800">
        <slot />
      </div>
    </main>

  </div>
</div>
