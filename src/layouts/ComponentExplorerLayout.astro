---
/**
 * ComponentExplorerLayout
 *
 * Purpose:
 * - Storybook-style layout with sidebar + main content.
 */

import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { title } = Astro.props;

const components = [
  { name: "Button", href: "/components/button" },
  { name: "Button Group", href: "/components/button-group" },
  { name: "Back Button", href: "/components/back-button" },
  { name: "Card", href: "/components/card" },
  { name: "CodeBlock", href: "/components/code-block" },
  { name: "FAQ Accordion", href: "/components/faq-accordion" },
  { name: "Hero", href: "/components/hero" },
  { name: "Header", href: "/components/header" },
  { name: "Footer", href: "/components/footer" }
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>

  <body class="min-h-screen flex flex-col text-gray-900 bg-white antialiased">
    <Header />

    <div class="flex flex-1">

      <!-- Sidebar -->
      <aside class="w-64 border-r bg-gray-50 p-6 space-y-4">
        <h2 class="text-xl font-bold mb-4">Components</h2>

        <nav class="space-y-2">
          {components.map((c) => (
            <a
              href={c.href}
              class="block px-3 py-2 rounded hover:bg-gray-200 transition"
            >
              {c.name}
            </a>
          ))}
        </nav>
      </aside>

      <!-- Main Content -->
      <main class="flex-1 p-10">
        <h1 class="text-3xl font-bold mb-6">{title}</h1>
        <slot />
      </main>

    </div>

    <Footer />
  </body>
</html>